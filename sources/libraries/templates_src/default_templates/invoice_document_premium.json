{
  "id": "doc-invoice-premium-001",
  "name": "Fattura / Ricevuta — Premium",
  "channel": "document",
  "description": "Fattura professionale con design moderno light. Variabili: company_name, company_address, company_vat, company_email, client_name, client_address, client_vat, invoice_number, invoice_date, due_date, item1_desc, item1_qty, item1_price, item2_desc, item2_qty, item2_price, item3_desc, item3_qty, item3_price, subtotal, tax_rate, tax_amount, total, notes, bank_details.",
  "subject": "Fattura {{ invoice_number }} — {{ company_name }}",
  "body_html": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Fattura {{ invoice_number }}</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');\n  :root {\n    --bg: #f8fafc;\n    --paper: #ffffff;\n    --ink: #0f172a;\n    --muted: #64748b;\n    --accent: #0ea5e9;\n    --accent-dark: #0369a1;\n    --green: #059669;\n    --border: #e2e8f0;\n    --stripe: #f1f5f9;\n    --font: 'Inter', system-ui, sans-serif;\n  }\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    font-family: var(--font);\n    background: var(--bg);\n    padding: 40px 20px;\n    color: var(--ink);\n  }\n  .invoice {\n    max-width: 820px;\n    margin: 0 auto;\n    background: var(--paper);\n    border-radius: 16px;\n    overflow: hidden;\n    box-shadow: 0 4px 32px rgba(0,0,0,0.08);\n  }\n\n  /* ── HEADER ── */\n  .inv-header {\n    background: var(--ink);\n    color: white;\n    padding: 40px 48px;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: 24px;\n    align-items: start;\n  }\n  .inv-company-name {\n    font-size: 1.6rem;\n    font-weight: 800;\n    margin-bottom: 6px;\n  }\n  .inv-company-details {\n    font-size: 0.8rem;\n    color: rgba(255,255,255,0.55);\n    line-height: 1.7;\n  }\n  .inv-badge {\n    text-align: right;\n  }\n  .inv-badge-label {\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 4px;\n  }\n  .inv-badge-num {\n    font-size: 1.8rem;\n    font-weight: 800;\n    color: white;\n    font-variant-numeric: tabular-nums;\n  }\n\n  /* ── META STRIP ── */\n  .inv-meta {\n    background: var(--accent);\n    padding: 0 48px;\n    display: flex;\n    gap: 32px;\n  }\n  .inv-meta-item {\n    padding: 16px 0;\n    border-right: 1px solid rgba(255,255,255,0.2);\n    padding-right: 32px;\n    last-child: border-right: none;\n  }\n  .inv-meta-item:last-child { border-right: none; }\n  .inv-meta-label {\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.65);\n    margin-bottom: 3px;\n  }\n  .inv-meta-value {\n    font-size: 0.88rem;\n    font-weight: 600;\n    color: white;\n  }\n\n  /* ── BODY ── */\n  .inv-body { padding: 40px 48px; }\n\n  /* Bill To */\n  .bill-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n    margin-bottom: 36px;\n  }\n  .bill-box {\n    background: var(--stripe);\n    border-radius: 10px;\n    padding: 20px 22px;\n    border: 1px solid var(--border);\n  }\n  .bill-box-title {\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 10px;\n  }\n  .bill-name {\n    font-size: 1rem;\n    font-weight: 700;\n    margin-bottom: 4px;\n  }\n  .bill-detail {\n    font-size: 0.82rem;\n    color: var(--muted);\n    line-height: 1.7;\n  }\n\n  /* Items Table */\n  .inv-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }\n  .inv-table thead tr {\n    background: var(--ink);\n    color: white;\n  }\n  .inv-table thead th {\n    padding: 12px 16px;\n    font-size: 0.72rem;\n    font-weight: 600;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    text-align: left;\n  }\n  .inv-table thead th:last-child { text-align: right; }\n  .inv-table tbody tr:nth-child(even) { background: var(--stripe); }\n  .inv-table tbody td {\n    padding: 14px 16px;\n    font-size: 0.88rem;\n    border-bottom: 1px solid var(--border);\n  }\n  .inv-table tbody td:last-child { text-align: right; font-weight: 600; }\n  .inv-table .item-qty { color: var(--muted); text-align: right; }\n  .inv-table .item-price { color: var(--muted); text-align: right; }\n\n  /* Totals */\n  .totals { margin-left: auto; width: 300px; }\n  .total-row {\n    display: flex;\n    justify-content: space-between;\n    padding: 8px 0;\n    font-size: 0.88rem;\n    border-bottom: 1px solid var(--border);\n  }\n  .total-row .label { color: var(--muted); }\n  .total-row.grand {\n    background: var(--ink);\n    color: white;\n    padding: 14px 16px;\n    border-radius: 8px;\n    margin-top: 8px;\n    font-size: 1.05rem;\n    font-weight: 700;\n    border-bottom: none;\n  }\n  .total-row.grand .label { color: rgba(255,255,255,0.7); }\n\n  /* Notes */\n  .inv-notes {\n    margin-top: 36px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n  }\n  .note-box {\n    background: var(--stripe);\n    border-radius: 10px;\n    padding: 18px 22px;\n    border: 1px solid var(--border);\n    font-size: 0.82rem;\n  }\n  .note-title {\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    color: var(--accent-dark);\n    margin-bottom: 8px;\n  }\n  .note-text { color: var(--muted); line-height: 1.7; }\n\n  /* Footer */\n  .inv-footer {\n    background: var(--stripe);\n    border-top: 1px solid var(--border);\n    padding: 18px 48px;\n    text-align: center;\n    font-size: 0.75rem;\n    color: var(--muted);\n  }\n  .paid-stamp {\n    display: inline-block;\n    border: 3px solid var(--green);\n    color: var(--green);\n    font-size: 1.4rem;\n    font-weight: 800;\n    letter-spacing: 4px;\n    padding: 6px 24px;\n    border-radius: 6px;\n    transform: rotate(-12deg);\n    opacity: 0.7;\n    float: right;\n    margin-top: -60px;\n  }\n\n  @media print {\n    body { background: white; padding: 0; }\n    .invoice { box-shadow: none; border-radius: 0; }\n    @page { margin: 0; size: A4; }\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n</style>\n</head>\n<body>\n<div class=\"invoice\">\n\n  <div class=\"inv-header\">\n    <div>\n      <div class=\"inv-company-name\">{{ company_name }}</div>\n      <div class=\"inv-company-details\">{{ company_address }}<br>P.IVA {{ company_vat }}<br>{{ company_email }}</div>\n    </div>\n    <div class=\"inv-badge\">\n      <div class=\"inv-badge-label\">Fattura</div>\n      <div class=\"inv-badge-num\">#{{ invoice_number }}</div>\n    </div>\n  </div>\n\n  <div class=\"inv-meta\">\n    <div class=\"inv-meta-item\">\n      <div class=\"inv-meta-label\">Data Emissione</div>\n      <div class=\"inv-meta-value\">{{ invoice_date }}</div>\n    </div>\n    <div class=\"inv-meta-item\">\n      <div class=\"inv-meta-label\">Scadenza</div>\n      <div class=\"inv-meta-value\">{{ due_date }}</div>\n    </div>\n    <div class=\"inv-meta-item\">\n      <div class=\"inv-meta-label\">Totale Dovuto</div>\n      <div class=\"inv-meta-value\">{{ total }}</div>\n    </div>\n  </div>\n\n  <div class=\"inv-body\">\n\n    <div class=\"bill-grid\">\n      <div class=\"bill-box\">\n        <div class=\"bill-box-title\">Da</div>\n        <div class=\"bill-name\">{{ company_name }}</div>\n        <div class=\"bill-detail\">{{ company_address }}<br>P.IVA {{ company_vat }}</div>\n      </div>\n      <div class=\"bill-box\">\n        <div class=\"bill-box-title\">A</div>\n        <div class=\"bill-name\">{{ client_name }}</div>\n        <div class=\"bill-detail\">{{ client_address }}<br>P.IVA {{ client_vat }}</div>\n      </div>\n    </div>\n\n    <table class=\"inv-table\">\n      <thead>\n        <tr>\n          <th style=\"width:50%\">Descrizione</th>\n          <th class=\"item-qty\">Qtà</th>\n          <th class=\"item-price\">Prezzo Unit.</th>\n          <th>Totale</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>{{ item1_desc }}</td>\n          <td class=\"item-qty\">{{ item1_qty }}</td>\n          <td class=\"item-price\">{{ item1_price }}</td>\n          <td>—</td>\n        </tr>\n        <tr>\n          <td>{{ item2_desc }}</td>\n          <td class=\"item-qty\">{{ item2_qty }}</td>\n          <td class=\"item-price\">{{ item2_price }}</td>\n          <td>—</td>\n        </tr>\n        <tr>\n          <td>{{ item3_desc }}</td>\n          <td class=\"item-qty\">{{ item3_qty }}</td>\n          <td class=\"item-price\">{{ item3_price }}</td>\n          <td>—</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"totals\">\n      <div class=\"total-row\"><span class=\"label\">Imponibile</span><span>{{ subtotal }}</span></div>\n      <div class=\"total-row\"><span class=\"label\">IVA {{ tax_rate }}</span><span>{{ tax_amount }}</span></div>\n      <div class=\"total-row grand\"><span class=\"label\">Totale</span><span>{{ total }}</span></div>\n    </div>\n\n    <div class=\"inv-notes\">\n      <div class=\"note-box\">\n        <div class=\"note-title\">Note</div>\n        <div class=\"note-text\">{{ notes }}</div>\n      </div>\n      <div class=\"note-box\">\n        <div class=\"note-title\">Coordinate Bancarie</div>\n        <div class=\"note-text\">{{ bank_details }}</div>\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"inv-footer\">\n    Grazie per la tua fiducia &mdash; {{ company_name }} &mdash; {{ company_email }}\n  </div>\n\n</div>\n</body>\n</html>",
