{
  "id": "00000000-0000-0000-0000-000000000001",
  "name": "Hecos — Generic Template (All Purpose)",
  "channel": "email",
  "description": "Elegant all-purpose email template. Magazine-style layout with Urania 9800 signature, social links, and full Hecos branding. Use for any notification or communication.",
  "subject": "{{ subject }}",
  "body_html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style type=\"text/css\">\n/*<![CDATA[*/\n  body { margin:0; padding:0; background-color:#0d1117; font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif; }\n  table { border-collapse:collapse; }\n  @media screen and (max-width:600px) {\n    .mobile-padding { padding: 16px !important; }\n  }\n/*]]>*/\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#0d1117;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0d1b4b;\">\n  <tr>\n    <td class=\"mobile-padding\" style=\"padding:18px 32px 26px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td width=\"64\" valign=\"middle\">\n            <img src=\"https://raw.githubusercontent.com/Hecos-Project/Hecos-Assets/main/Hecos_Logo_SQR_NBG_LogoOnly.png\" alt=\"Hecos Logo\" style=\"width:64px;height:64px;border-radius:14px;display:block;\">\n          </td>\n          <td valign=\"middle\" style=\"padding-left:20px;\">\n            <p style=\"margin:0;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#6c63ff;font-weight:700;\">Hecos</p>\n            <h1 style=\"margin:4px 0 2px;font-size:22px;font-weight:800;color:#ffffff;line-height:1.2;\">Helping Companion System</h1>\n            <p style=\"margin:0;font-size:12px;color:rgba(255,255,255,0.5);font-style:italic;\">Your intelligent automation partner</p>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#161b22;\">\n  <tr>\n    <td class=\"mobile-padding\" style=\"padding:32px 32px 28px;\">\n      \n      <!-- Top Row: Badge & Content -->\n      <!--[if mso]><table role=\"presentation\" width=\"100%\"><tr><td width=\"200\" valign=\"top\"><![endif]-->\n      <div style=\"display:inline-block;width:100%;max-width:200px;vertical-align:top;\">\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td style=\"padding-right:20px;padding-bottom:20px;text-align:left;\">\n              <!-- Subject badge -->\n              <div style=\"display:inline-block;background-color:rgba(108,99,255,0.15);border:1px solid rgba(108,99,255,0.3);border-radius:20px;padding:4px 14px;margin-bottom:16px;\">\n                <span style=\"font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#6c63ff;\">{{ subject }}</span>\n              </div>\n              <br>\n              <!-- Image -->\n              <img src=\"{{ image_main }}\" alt=\"Urania 9800\" style=\"width:100%;max-width:175px;height:auto;border-radius:12px;display:block;border:2px solid rgba(108,99,255,0.35);\">\n            </td>\n          </tr>\n        </table>\n      </div>\n      <!--[if mso]></td><td width=\"400\" valign=\"top\"><![endif]-->\n      <div style=\"display:inline-block;width:100%;max-width:400px;vertical-align:top;padding-top:40px;\">\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td style=\"font-size:14px;padding-bottom:20px;text-align:left;\">\n              <h2 style=\"margin:0 0 6px;font-size:24px;font-weight:800;color:#ffffff;line-height:1.2;\">{{ subject }}</h2>\n              <p style=\"margin:0;font-size:14px;color:#6c63ff;font-weight:600;\">{{ subtitle }}</p>\n            </td>\n          </tr>\n        </table>\n      </div>\n      <!--[if mso]></td></tr></table><![endif]-->\n\n      <div style=\"clear:both;\"></div>\n\n      <!-- Regular text below -->\n      <div style=\"margin-top: 24px; margin-bottom: 24px;\">\n        <p style=\"margin:0 0 12px;font-size:14px;line-height:1.75;color:rgba(255,255,255,0.82);text-align:left;\">{{ message }}</p>\n      </div>\n\n      <!-- Divider -->\n      <div style=\"height:1px;background-color:rgba(108,99,255,0.6);margin:24px 0 28px;\"></div>\n\n      <!-- CTA Button -->\n      <div style=\"text-align:left;margin-bottom:24px;\">\n        <a href=\"https://github.com/Hecos-Project/Hecos/releases\"\n           style=\"display:inline-block;background-color:#6c63ff;color:#ffffff;text-decoration:none;padding:12px 36px;border-radius:8px;font-weight:700;font-size:14px;\">\n          &#128640; Discover Hecos\n        </a>\n      </div>\n\n    </td>\n  </tr>\n</table>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0a0f1e;border-top:1px solid rgba(108,99,255,0.2);\">\n  <tr>\n    <td class=\"mobile-padding\" style=\"padding:28px 32px;\">\n\n      <!-- Urania signature -->\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:20px;\">\n        <tr>\n          <td valign=\"middle\" width=\"60\">\n            <img src=\"{{ image_avatar }}\" alt=\"Urania\" style=\"width:48px;height:auto;max-height:48px;border-radius:12px;display:block;border:2px solid rgba(108,99,255,0.5);\">\n          </td>\n          <td valign=\"middle\" style=\"padding-left:14px;\">\n            <p style=\"margin:0;font-size:14px;font-weight:700;color:#ffffff;\">Urania 9800</p>\n            <p style=\"margin:3px 0 0;font-size:12px;color:rgba(255,255,255,0.4);font-style:italic;\">&ldquo;Intelligenza che agisce. Eleganza che connette.&rdquo;</p>\n          </td>\n        </tr>\n      </table>\n\n      <!-- Social links -->\n      <div style=\"margin-bottom:20px;\">\n        <a href=\"https://github.com/Hecos-Project/Hecos/releases\"\n           style=\"display:inline-block;margin-right:8px;margin-bottom:8px;background-color:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:7px 13px;color:rgba(255,255,255,0.75);text-decoration:none;font-size:12px;font-weight:600;\">&#11015;&#65039; Download Hecos</a>\n        <a href=\"https://www.youtube.com/@Hecos-Project\"\n           style=\"display:inline-block;margin-right:8px;margin-bottom:8px;background-color:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:7px 13px;color:rgba(255,255,255,0.75);text-decoration:none;font-size:12px;font-weight:600;\">&#9654;&#65039; YouTube</a>\n        <a href=\"https://t.me/hecos_project\"\n           style=\"display:inline-block;margin-bottom:8px;background-color:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:7px 13px;color:rgba(255,255,255,0.75);text-decoration:none;font-size:12px;font-weight:600;\">&#128241; Telegram</a>\n      </div>\n\n      <!-- Fine print -->\n      <p style=\"margin:0 0 5px;font-size:11px;color:rgba(255,255,255,0.3);line-height:1.6;\">This message was sent automatically by <strong style=\"color:rgba(108,99,255,0.6);\">Hecos &mdash; Helping Companion System</strong>. An open-source AI automation platform.</p>\n      <p style=\"margin:0;font-size:11px;color:rgba(255,255,255,0.18);\">&copy; 2024&ndash;2026 Hecos Project &middot; <a href=\"https://github.com/Hecos-Project/Hecos\" style=\"color:rgba(108,99,255,0.4);text-decoration:none;\">GitHub</a></p>\n\n    </td>\n  </tr>\n</table>\n</body>\n</html>",
