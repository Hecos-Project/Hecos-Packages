{
  "id": "00000000-0000-0000-0000-000000000011",
  "name": "Rivista Glamour — 6 Foto Editoriale",
  "channel": "document",
  "description": "Template rivista editoriale premium con layout a pagina intera, hero image, griglia 3 colonne per 6 foto con didascalie elaborate. Stile magazine di alta moda. Variabili: title, subtitle, editorial_intro, img1-img6, caption1-caption6, author_name, closing_text.",
  "subject": "{{ title }}",
  "body_html": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n<meta charset=\"UTF-8\">\n<title>{{ title }}</title>\n<style>\n  :root {\n    --bg: #0a0a14;\n    --surface: #12121f;\n    --accent-1: #e63946;\n    --accent-2: #f4a261;\n    --accent-3: #a8dadc;\n    --gold: #d4af37;\n    --text: #eaeaea;\n    --text-dim: rgba(255,255,255,0.45);\n    --font-title: 'Georgia', 'Playfair Display', serif;\n    --font-body: 'Segoe UI', 'Inter', 'Helvetica Neue', sans-serif;\n  }\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: var(--font-body);\n    background: var(--bg);\n    color: var(--text);\n  }\n  /* ── MASTHEAD ───────────────────────── */\n  .masthead {\n    text-align: center;\n    padding: 50px 40px 30px;\n    border-bottom: 1px solid rgba(212,175,55,0.3);\n  }\n  .masthead .logo-text {\n    font-family: var(--font-title);\n    font-size: 0.9em;\n    letter-spacing: 12px;\n    text-transform: uppercase;\n    color: var(--gold);\n  }\n  .masthead h1 {\n    font-family: var(--font-title);\n    font-size: 4em;\n    font-weight: 400;\n    letter-spacing: 4px;\n    margin: 16px 0 8px;\n    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .masthead .tagline {\n    font-size: 1.1em;\n    color: var(--text-dim);\n    font-style: italic;\n    letter-spacing: 2px;\n  }\n  /* ── HERO SECTION ───────────────────── */\n  .hero {\n    position: relative;\n    max-width: 900px;\n    margin: 40px auto;\n    padding: 0 40px;\n  }\n  .hero img {\n    width: 100%;\n    height: 500px;\n    object-fit: cover;\n    border-radius: 8px;\n    box-shadow: 0 20px 60px rgba(0,0,0,0.6);\n  }\n  .hero .hero-caption {\n    position: absolute;\n    bottom: 24px;\n    left: 56px;\n    right: 56px;\n    background: rgba(0,0,0,0.7);\n    backdrop-filter: blur(8px);\n    padding: 20px 24px;\n    border-radius: 8px;\n    border-left: 4px solid var(--accent-1);\n  }\n  .hero .hero-caption p {\n    font-size: 1.1em;\n    line-height: 1.6;\n    color: rgba(255,255,255,0.9);\n  }\n  /* ── EDITORIAL INTRO ────────────────── */\n  .editorial {\n    max-width: 750px;\n    margin: 50px auto;\n    padding: 0 40px;\n    columns: 2;\n    column-gap: 40px;\n    font-size: 1.05em;\n    line-height: 2;\n    color: rgba(255,255,255,0.75);\n    text-align: justify;\n  }\n  .editorial::first-letter {\n    font-family: var(--font-title);\n    font-size: 4em;\n    float: left;\n    line-height: 0.75;\n    margin-right: 12px;\n    margin-top: 6px;\n    color: var(--accent-1);\n  }\n  /* ── PHOTO GRID ─────────────────────── */\n  .divider {\n    max-width: 900px;\n    margin: 20px auto 40px;\n    padding: 0 40px;\n    text-align: center;\n  }\n  .divider span {\n    display: inline-block;\n    font-family: var(--font-title);\n    font-size: 0.8em;\n    letter-spacing: 8px;\n    text-transform: uppercase;\n    color: var(--gold);\n    padding: 0 20px;\n    position: relative;\n  }\n  .divider span::before,\n  .divider span::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    width: 120px;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, var(--gold), transparent);\n  }\n  .divider span::before { right: 100%; }\n  .divider span::after { left: 100%; }\n  .photo-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n    max-width: 900px;\n    margin: 0 auto 50px;\n    padding: 0 40px;\n  }\n  .grid-item {\n    background: var(--surface);\n    border-radius: 12px;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,0.05);\n    transition: all 0.3s ease;\n  }\n  .grid-item:hover {\n    transform: scale(1.03);\n    box-shadow: 0 15px 35px rgba(0,0,0,0.5);\n    border-color: rgba(230,57,70,0.3);\n  }\n  .grid-item img {\n    width: 100%;\n    height: 280px;\n    object-fit: cover;\n    display: block;\n  }\n  .grid-item .item-caption {\n    padding: 16px 14px;\n    font-size: 0.88em;\n    line-height: 1.5;\n    color: var(--accent-3);\n    text-align: center;\n  }\n  .grid-item .item-caption strong {\n    display: block;\n    font-size: 0.75em;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: var(--accent-2);\n    margin-bottom: 6px;\n  }\n  /* ── CLOSING ────────────────────────── */\n  .closing {\n    max-width: 750px;\n    margin: 30px auto 50px;\n    padding: 30px 40px;\n    text-align: center;\n    font-size: 1.1em;\n    line-height: 1.8;\n    color: rgba(255,255,255,0.65);\n    font-style: italic;\n    border-top: 1px solid rgba(212,175,55,0.2);\n    border-bottom: 1px solid rgba(212,175,55,0.2);\n  }\n  /* ── COLOPHON ───────────────────────── */\n  .colophon {\n    text-align: center;\n    padding: 30px 40px;\n    font-size: 0.8em;\n    color: var(--text-dim);\n    letter-spacing: 1px;\n  }\n  .colophon .author {\n    color: var(--gold);\n    font-weight: 700;\n  }\n  @media print {\n    body { background: var(--bg) !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n    .grid-item, .hero { break-inside: avoid; }\n    .editorial { columns: 2; }\n  }\n</style>\n</head>\n<body>\n  <div class=\"masthead\">\n    <div class=\"logo-text\">Hecos Magazine</div>\n    <h1>{{ title }}</h1>\n    <div class=\"tagline\">{{ subtitle }}</div>\n  </div>\n\n  <div class=\"hero\">\n    <img src=\"{{ img1 }}\" alt=\"Hero\">\n    <div class=\"hero-caption\">\n      <p>{{ caption1 }}</p>\n    </div>\n  </div>\n\n  <div class=\"editorial\">\n    {{ editorial_intro }}\n  </div>\n\n  <div class=\"divider\"><span>Galleria</span></div>\n\n  <div class=\"photo-grid\">\n    <div class=\"grid-item\">\n      <img src=\"{{ img2 }}\" alt=\"Foto 2\">\n      <div class=\"item-caption\"><strong>II</strong>{{ caption2 }}</div>\n    </div>\n    <div class=\"grid-item\">\n      <img src=\"{{ img3 }}\" alt=\"Foto 3\">\n      <div class=\"item-caption\"><strong>III</strong>{{ caption3 }}</div>\n    </div>\n    <div class=\"grid-item\">\n      <img src=\"{{ img4 }}\" alt=\"Foto 4\">\n      <div class=\"item-caption\"><strong>IV</strong>{{ caption4 }}</div>\n    </div>\n    <div class=\"grid-item\">\n      <img src=\"{{ img5 }}\" alt=\"Foto 5\">\n      <div class=\"item-caption\"><strong>V</strong>{{ caption5 }}</div>\n    </div>\n    <div class=\"grid-item\">\n      <img src=\"{{ img6 }}\" alt=\"Foto 6\">\n      <div class=\"item-caption\"><strong>VI</strong>{{ caption6 }}</div>\n    </div>\n  </div>\n\n  <div class=\"closing\">\n    <p>{{ closing_text }}</p>\n  </div>\n\n  <div class=\"colophon\">\n    <p>Fotografia e testo di <span class=\"author\">{{ author_name }}</span></p>\n    <p style=\"margin-top:4px;\">Generato con Hecos Document Maker</p>\n  </div>\n</body>\n</html>",
