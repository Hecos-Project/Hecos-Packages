{
  "id": "doc-report-editorial-001",
  "name": "Report Editoriale — Clean Light",
  "channel": "document",
  "description": "Report editoriale minimalista con layout a due colonne, typography serif elegante su sfondo bianco. Perfetto per white paper, analisi, saggi. Variabili: title, subtitle, category, date, author_name, author_bio, abstract, section1_title, section1_body, section2_title, section2_body, section3_title, section3_body, conclusion, footer_text.",
  "subject": "{{ title }}",
  "body_html": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n<meta charset=\"UTF-8\">\n<title>{{ title }}</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,400&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap');\n  :root {\n    --bg: #fffff8;\n    --ink: #1a1208;\n    --muted: #6b5c41;\n    --accent: #8b1a1a;\n    --light-accent: #f5eeee;\n    --border: #e5d9c8;\n    --serif: 'Playfair Display', Georgia, serif;\n    --body-serif: 'Source Serif 4', Georgia, serif;\n    --sans: 'Inter', system-ui, sans-serif;\n  }\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    font-family: var(--body-serif);\n    background: var(--bg);\n    color: var(--ink);\n    font-size: 17px;\n    line-height: 1.8;\n  }\n\n  /* ── MASTHEAD ── */\n  .masthead {\n    border-bottom: 3px double var(--ink);\n    padding: 32px 72px 20px;\n    text-align: center;\n  }\n  .masthead-cat {\n    font-family: var(--sans);\n    font-size: 0.65rem;\n    font-weight: 600;\n    letter-spacing: 4px;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 14px;\n  }\n  .masthead-title {\n    font-family: var(--serif);\n    font-size: 3rem;\n    font-weight: 800;\n    line-height: 1.1;\n    color: var(--ink);\n    margin-bottom: 12px;\n  }\n  .masthead-subtitle {\n    font-family: var(--body-serif);\n    font-style: italic;\n    font-size: 1.15rem;\n    color: var(--muted);\n    max-width: 580px;\n    margin: 0 auto 20px;\n  }\n  .masthead-meta {\n    font-family: var(--sans);\n    font-size: 0.75rem;\n    color: var(--muted);\n    display: flex;\n    justify-content: center;\n    gap: 24px;\n    border-top: 1px solid var(--border);\n    padding-top: 14px;\n  }\n  .masthead-meta span { display: flex; align-items: center; gap: 4px; }\n  .masthead-meta strong { color: var(--ink); }\n\n  /* ── LAYOUT ── */\n  .doc-wrapper {\n    max-width: 1020px;\n    margin: 0 auto;\n    padding: 48px 72px;\n    display: grid;\n    grid-template-columns: 2fr 1fr;\n    gap: 56px;\n    align-items: start;\n  }\n\n  /* ── MAIN COLUMN ── */\n  .main-col {}\n\n  /* Abstract */\n  .abstract {\n    font-family: var(--body-serif);\n    font-style: italic;\n    font-size: 1.1rem;\n    color: var(--ink);\n    border-left: 3px solid var(--accent);\n    padding: 20px 24px;\n    background: var(--light-accent);\n    margin-bottom: 40px;\n    line-height: 1.9;\n  }\n\n  /* Section */\n  .section { margin-bottom: 40px; }\n  .section-title {\n    font-family: var(--serif);\n    font-size: 1.4rem;\n    font-weight: 700;\n    color: var(--ink);\n    margin-bottom: 14px;\n    padding-bottom: 8px;\n    border-bottom: 1px solid var(--border);\n  }\n  .section-body {\n    font-size: 0.97rem;\n    line-height: 1.95;\n    color: #2a2010;\n    text-align: justify;\n  }\n  .section-body p { margin-bottom: 14px; }\n\n  /* Drop cap for first paragraph */\n  .drop-cap::first-letter {\n    font-family: var(--serif);\n    font-size: 4em;\n    font-weight: 800;\n    float: left;\n    line-height: 0.72;\n    margin: 6px 10px 0 -2px;\n    color: var(--accent);\n  }\n\n  /* Conclusion */\n  .conclusion {\n    background: var(--ink);\n    color: white;\n    padding: 28px 32px;\n    border-radius: 4px;\n    margin-top: 40px;\n  }\n  .conclusion-label {\n    font-family: var(--sans);\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.45);\n    margin-bottom: 10px;\n  }\n  .conclusion-text {\n    font-family: var(--body-serif);\n    font-style: italic;\n    font-size: 1rem;\n    line-height: 1.8;\n    color: rgba(255,255,255,0.9);\n  }\n\n  /* ── SIDEBAR ── */\n  .side-col { padding-top: 8px; }\n  .side-widget {\n    border: 1px solid var(--border);\n    border-radius: 4px;\n    margin-bottom: 28px;\n    overflow: hidden;\n  }\n  .side-widget-title {\n    background: var(--ink);\n    color: white;\n    font-family: var(--sans);\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 2.5px;\n    text-transform: uppercase;\n    padding: 10px 16px;\n  }\n  .side-widget-body {\n    padding: 16px;\n    font-size: 0.82rem;\n    color: var(--muted);\n    line-height: 1.7;\n    background: var(--bg);\n  }\n  .author-name {\n    font-family: var(--serif);\n    font-size: 1rem;\n    font-weight: 700;\n    color: var(--ink);\n    margin-bottom: 6px;\n  }\n\n  /* ── FOOTER ── */\n  .doc-footer {\n    border-top: 3px double var(--ink);\n    padding: 18px 72px;\n    display: flex;\n    justify-content: space-between;\n    font-family: var(--sans);\n    font-size: 0.72rem;\n    color: var(--muted);\n  }\n\n  /* ── PRINT ── */\n  @media print {\n    body { background: white; }\n    .doc-wrapper { grid-template-columns: 1fr; }\n    .side-col { display: none; }\n    @page { margin: 2cm; size: A4; }\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"masthead\">\n  <div class=\"masthead-cat\">{{ category }}</div>\n  <h1 class=\"masthead-title\">{{ title }}</h1>\n  <p class=\"masthead-subtitle\">{{ subtitle }}</p>\n  <div class=\"masthead-meta\">\n    <span>🗓 <strong>{{ date }}</strong></span>\n    <span>✍ <strong>{{ author_name }}</strong></span>\n  </div>\n</div>\n\n<div class=\"doc-wrapper\">\n\n  <div class=\"main-col\">\n    <div class=\"abstract\">{{ abstract }}</div>\n\n    <div class=\"section\">\n      <h2 class=\"section-title\">{{ section1_title }}</h2>\n      <div class=\"section-body\">\n        <p class=\"drop-cap\">{{ section1_body }}</p>\n      </div>\n    </div>\n\n    <div class=\"section\">\n      <h2 class=\"section-title\">{{ section2_title }}</h2>\n      <div class=\"section-body\"><p>{{ section2_body }}</p></div>\n    </div>\n\n    <div class=\"section\">\n      <h2 class=\"section-title\">{{ section3_title }}</h2>\n      <div class=\"section-body\"><p>{{ section3_body }}</p></div>\n    </div>\n\n    <div class=\"conclusion\">\n      <div class=\"conclusion-label\">Conclusioni</div>\n      <div class=\"conclusion-text\">{{ conclusion }}</div>\n    </div>\n  </div>\n\n  <div class=\"side-col\">\n    <div class=\"side-widget\">\n      <div class=\"side-widget-title\">L'Autore</div>\n      <div class=\"side-widget-body\">\n        <div class=\"author-name\">{{ author_name }}</div>\n        {{ author_bio }}\n      </div>\n    </div>\n    <div class=\"side-widget\">\n      <div class=\"side-widget-title\">In questo documento</div>\n      <div class=\"side-widget-body\">\n        ▸ {{ section1_title }}<br><br>\n        ▸ {{ section2_title }}<br><br>\n        ▸ {{ section3_title }}\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<div class=\"doc-footer\">\n  <span>{{ title }}</span>\n  <span>{{ footer_text }}</span>\n</div>\n\n</body>\n</html>",
  "body_text": "",
  "header": "",
  "footer": "",
  "tags": ["report", "editorial", "white-paper", "analisi", "saggio", "professional", "document", "light", "serif"],
  "is_default": true,
  "variables": ["title","subtitle","category","date","author_name","author_bio","abstract","section1_title","section1_body","section2_title","section2_body","section3_title","section3_body","conclusion","footer_text"],
  "created_at": "2026-09-19T08:00:00.000000+00:00",
  "updated_at": "2026-09-19T08:00:00.000000+00:00",
