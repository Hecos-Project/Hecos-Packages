{
  "id": "doc-letter-formal-001",
  "name": "Lettera Formale — Carta Intestata",
  "channel": "document",
  "description": "Lettera formale con carta intestata professionale su sfondo bianco/crema. Variabili: company_name, company_address, company_email, company_phone, recipient_name, recipient_title, recipient_company, recipient_address, city, date, reference, subject, salutation, body_paragraph1, body_paragraph2, body_paragraph3, closing, sender_name, sender_title.",
  "subject": "{{ subject }} — {{ company_name }}",
  "body_html": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>{{ subject }}</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap');\n  :root {\n    --paper: #faf9f6;\n    --ink: #1a1a2e;\n    --muted: #6b7280;\n    --accent: #1e3a5f;\n    --accent-light: #e8eef5;\n    --gold: #c8a951;\n    --border: #d4c5a9;\n    --font-serif: 'Lora', Georgia, serif;\n    --font-sans: 'Inter', system-ui, sans-serif;\n  }\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    font-family: var(--font-sans);\n    background: #e8e4dc;\n    min-height: 100vh;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    padding: 40px 20px;\n  }\n\n  /* ── PAPER SHEET ── */\n  .paper {\n    background: var(--paper);\n    width: 100%;\n    max-width: 760px;\n    min-height: 1050px;\n    box-shadow: 0 4px 40px rgba(0,0,0,0.18), 0 1px 4px rgba(0,0,0,0.08);\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* ── HEADER ── */\n  .letter-header {\n    background: var(--accent);\n    padding: 36px 52px;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    border-bottom: 4px solid var(--gold);\n  }\n  .company-name {\n    font-family: var(--font-serif);\n    font-size: 1.9rem;\n    font-weight: 700;\n    color: #fff;\n    letter-spacing: -0.3px;\n  }\n  .company-contact {\n    font-size: 0.78rem;\n    color: rgba(255,255,255,0.65);\n    text-align: right;\n    line-height: 1.7;\n  }\n\n  /* ── ACCENT BAR ── */\n  .accent-line {\n    height: 3px;\n    background: linear-gradient(90deg, var(--gold), transparent);\n  }\n\n  /* ── BODY ── */\n  .letter-body { padding: 50px 52px; }\n\n  /* Date & Reference */\n  .letter-meta {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 36px;\n    font-size: 0.83rem;\n    color: var(--muted);\n  }\n  .letter-date { font-weight: 600; color: var(--ink); }\n  .letter-ref {\n    background: var(--accent-light);\n    border: 1px solid #c8d8ea;\n    padding: 4px 12px;\n    border-radius: 4px;\n    font-size: 0.75rem;\n    font-weight: 600;\n    color: var(--accent);\n    letter-spacing: 0.5px;\n  }\n\n  /* Recipient */\n  .recipient {\n    margin-bottom: 36px;\n    font-size: 0.92rem;\n    line-height: 1.8;\n  }\n  .recipient strong { color: var(--ink); font-size: 1rem; }\n  .recipient .rec-title { color: var(--muted); font-size: 0.82rem; }\n\n  /* Subject */\n  .letter-subject {\n    font-family: var(--font-serif);\n    font-size: 1.15rem;\n    font-weight: 600;\n    color: var(--accent);\n    padding: 14px 18px;\n    border-left: 3px solid var(--gold);\n    background: var(--accent-light);\n    margin-bottom: 28px;\n  }\n\n  /* Salutation */\n  .salutation {\n    font-family: var(--font-serif);\n    font-size: 1rem;\n    margin-bottom: 22px;\n    color: var(--ink);\n  }\n\n  /* Paragraph */\n  .para {\n    font-size: 0.95rem;\n    line-height: 1.9;\n    color: #2d2d2d;\n    margin-bottom: 18px;\n    text-align: justify;\n    font-family: var(--font-serif);\n  }\n  .para:first-letter { /* Only on first para */\n  }\n\n  /* Closing */\n  .closing-block {\n    margin-top: 40px;\n  }\n  .closing-salute {\n    font-family: var(--font-serif);\n    font-style: italic;\n    font-size: 1rem;\n    color: var(--ink);\n    margin-bottom: 40px;\n  }\n  .signature-line {\n    border-top: 1.5px solid #c4b99a;\n    width: 220px;\n    margin-bottom: 10px;\n  }\n  .sender-name {\n    font-weight: 700;\n    font-size: 0.95rem;\n    color: var(--ink);\n    font-family: var(--font-serif);\n  }\n  .sender-title {\n    font-size: 0.8rem;\n    color: var(--muted);\n    margin-top: 3px;\n  }\n\n  /* ── FOOTER ── */\n  .letter-footer {\n    position: absolute;\n    bottom: 0; left: 0; right: 0;\n    background: var(--accent-light);\n    border-top: 1px solid var(--border);\n    padding: 12px 52px;\n    display: flex;\n    justify-content: space-between;\n    font-size: 0.72rem;\n    color: var(--muted);\n  }\n  .footer-gold-bar {\n    height: 3px;\n    background: var(--gold);\n    position: absolute;\n    bottom: 0; left: 0; right: 0;\n  }\n\n  /* ── PRINT ── */\n  @media print {\n    body { background: white; padding: 0; }\n    .paper { box-shadow: none; max-width: 100%; min-height: auto; }\n    .letter-footer { position: fixed; }\n    @page { margin: 0; size: A4; }\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n</style>\n</head>\n<body>\n<div class=\"paper\">\n\n  <div class=\"letter-header\">\n    <div class=\"company-name\">{{ company_name }}</div>\n    <div class=\"company-contact\">\n      {{ company_address }}<br>\n      {{ company_email }}<br>\n      {{ company_phone }}\n    </div>\n  </div>\n  <div class=\"accent-line\"></div>\n\n  <div class=\"letter-body\">\n    <div class=\"letter-meta\">\n      <span class=\"letter-date\">{{ city }}, {{ date }}</span>\n      <span class=\"letter-ref\">Rif. {{ reference }}</span>\n    </div>\n\n    <div class=\"recipient\">\n      <strong>{{ recipient_name }}</strong><br>\n      <span class=\"rec-title\">{{ recipient_title }}</span><br>\n      {{ recipient_company }}<br>\n      {{ recipient_address }}\n    </div>\n\n    <div class=\"letter-subject\">Oggetto: {{ subject }}</div>\n\n    <div class=\"salutation\">{{ salutation }},</div>\n\n    <p class=\"para\">{{ body_paragraph1 }}</p>\n    <p class=\"para\">{{ body_paragraph2 }}</p>\n    <p class=\"para\">{{ body_paragraph3 }}</p>\n\n    <div class=\"closing-block\">\n      <div class=\"closing-salute\">{{ closing }}</div>\n      <div class=\"signature-line\"></div>\n      <div class=\"sender-name\">{{ sender_name }}</div>\n      <div class=\"sender-title\">{{ sender_title }}</div>\n    </div>\n  </div>\n\n  <div class=\"letter-footer\">\n    <span>{{ company_name }}</span>\n    <span>{{ company_address }}</span>\n    <span>{{ company_email }}</span>\n    <div class=\"footer-gold-bar\"></div>\n  </div>\n\n</div>\n</body>\n</html>",
  "body_text": "",
  "header": "",
  "footer": "",
  "tags": ["letter", "formal", "carta-intestata", "business", "professional", "document", "light"],
  "is_default": true,
  "variables": ["company_name","company_address","company_email","company_phone","recipient_name","recipient_title","recipient_company","recipient_address","city","date","reference","subject","salutation","body_paragraph1","body_paragraph2","body_paragraph3","closing","sender_name","sender_title"],
