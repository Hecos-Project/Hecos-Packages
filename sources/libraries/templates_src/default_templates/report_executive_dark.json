{
  "id": "doc-report-executive-001",
  "name": "Executive Report — Dark Premium",
  "channel": "document",
  "description": "Report aziendale executive con design dark premium, KPI cards, sezione summary e tabella dati. Variabili: company, report_title, report_date, author, executive_summary, kpi1_label, kpi1_value, kpi2_label, kpi2_value, kpi3_label, kpi3_value, kpi4_label, kpi4_value, section1_title, section1_content, section2_title, section2_content, footer_text.",
  "subject": "{{ report_title }} — {{ company }}",
  "body_html": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>{{ report_title }}</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');\n  :root {\n    --bg: #070b14;\n    --bg2: #0d1421;\n    --bg3: #111827;\n    --accent: #6366f1;\n    --accent2: #818cf8;\n    --green: #10b981;\n    --yellow: #f59e0b;\n    --red: #ef4444;\n    --text: #f1f5f9;\n    --muted: #64748b;\n    --border: rgba(99,102,241,0.18);\n    --card: rgba(255,255,255,0.04);\n    --font: 'Inter', system-ui, sans-serif;\n    --mono: 'JetBrains Mono', monospace;\n  }\n  * { margin:0; padding:0; box-sizing:border-box; }\n  html { font-size:16px; }\n  body {\n    font-family: var(--font);\n    background: var(--bg);\n    color: var(--text);\n    min-height: 100vh;\n    line-height: 1.6;\n  }\n\n  /* ── TOP BAR ── */\n  .topbar {\n    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);\n    border-bottom: 1px solid var(--border);\n    padding: 0 60px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    height: 72px;\n  }\n  .topbar-logo {\n    font-size: 1.4rem;\n    font-weight: 800;\n    letter-spacing: -0.5px;\n    background: linear-gradient(135deg, var(--accent2) 0%, #a78bfa 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .topbar-meta {\n    font-size: 0.78rem;\n    color: var(--muted);\n    font-family: var(--mono);\n    text-align: right;\n  }\n\n  /* ── HERO ── */\n  .hero {\n    padding: 70px 60px 50px;\n    background: linear-gradient(180deg, #0d1421 0%, var(--bg) 100%);\n    border-bottom: 1px solid var(--border);\n    position: relative;\n    overflow: hidden;\n  }\n  .hero::before {\n    content: '';\n    position: absolute;\n    top: -80px; left: -80px;\n    width: 400px; height: 400px;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(99,102,241,0.12) 0%, transparent 70%);\n    pointer-events: none;\n  }\n  .hero-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: rgba(99,102,241,0.15);\n    border: 1px solid rgba(99,102,241,0.3);\n    color: var(--accent2);\n    font-size: 0.72rem;\n    font-weight: 600;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    padding: 5px 14px;\n    border-radius: 100px;\n    margin-bottom: 24px;\n  }\n  .hero-title {\n    font-size: 2.8rem;\n    font-weight: 800;\n    line-height: 1.15;\n    letter-spacing: -1px;\n    margin-bottom: 16px;\n    max-width: 700px;\n  }\n  .hero-subtitle {\n    font-size: 1.05rem;\n    color: var(--muted);\n    max-width: 600px;\n    font-weight: 400;\n  }\n  .hero-divider {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    margin-top: 32px;\n    font-size: 0.82rem;\n    color: var(--muted);\n  }\n  .hero-divider span { color: var(--accent2); font-weight: 600; }\n  .hero-divider::after {\n    content: '';\n    flex: 1;\n    height: 1px;\n    background: var(--border);\n  }\n\n  /* ── MAIN CONTENT ── */\n  .main { padding: 50px 60px; max-width: 1100px; margin: 0 auto; }\n\n  /* ── KPI CARDS ── */\n  .kpi-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n    margin-bottom: 48px;\n  }\n  .kpi-card {\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 16px;\n    padding: 24px 20px;\n    position: relative;\n    overflow: hidden;\n    transition: transform 0.2s, box-shadow 0.2s;\n  }\n  .kpi-card:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 32px rgba(99,102,241,0.15);\n  }\n  .kpi-card::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 2px;\n    background: linear-gradient(90deg, var(--accent), var(--accent2));\n  }\n  .kpi-label {\n    font-size: 0.72rem;\n    font-weight: 600;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    color: var(--muted);\n    margin-bottom: 10px;\n  }\n  .kpi-value {\n    font-size: 2rem;\n    font-weight: 800;\n    font-family: var(--mono);\n    color: var(--text);\n    line-height: 1;\n  }\n\n  /* ── SECTION ── */\n  .section { margin-bottom: 48px; }\n  .section-header {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 20px;\n    padding-bottom: 12px;\n    border-bottom: 1px solid var(--border);\n  }\n  .section-num {\n    background: var(--accent);\n    color: white;\n    font-size: 0.7rem;\n    font-weight: 700;\n    font-family: var(--mono);\n    width: 24px; height: 24px;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .section-title {\n    font-size: 1.15rem;\n    font-weight: 700;\n    color: var(--text);\n  }\n  .section-content {\n    font-size: 0.95rem;\n    color: rgba(241,245,249,0.75);\n    line-height: 1.85;\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    padding: 24px 28px;\n  }\n\n  /* ── SUMMARY BOX ── */\n  .summary-box {\n    background: linear-gradient(135deg, rgba(99,102,241,0.1) 0%, rgba(129,140,248,0.05) 100%);\n    border: 1px solid rgba(99,102,241,0.3);\n    border-radius: 16px;\n    padding: 28px 32px;\n    margin-bottom: 40px;\n    position: relative;\n  }\n  .summary-box::before {\n    content: '▎';\n    position: absolute;\n    left: 0; top: 0; bottom: 0;\n    width: 4px;\n    background: linear-gradient(180deg, var(--accent), var(--accent2));\n    border-radius: 4px 0 0 4px;\n  }\n  .summary-label {\n    font-size: 0.7rem;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: var(--accent2);\n    margin-bottom: 10px;\n  }\n  .summary-text {\n    font-size: 1rem;\n    line-height: 1.8;\n    color: rgba(241,245,249,0.85);\n  }\n\n  /* ── FOOTER ── */\n  .doc-footer {\n    border-top: 1px solid var(--border);\n    padding: 24px 60px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 0.75rem;\n    color: var(--muted);\n    font-family: var(--mono);\n    background: var(--bg2);\n    margin-top: 40px;\n  }\n\n  /* ── PRINT ── */\n  @media print {\n    body { background: #070b14 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n    .kpi-card, .section-content, .summary-box { break-inside: avoid; }\n    @page { margin: 0; size: A4; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"topbar\">\n  <div class=\"topbar-logo\">{{ company }}</div>\n  <div class=\"topbar-meta\">CONFIDENTIAL &nbsp;·&nbsp; {{ report_date }}<br>Author: {{ author }}</div>\n</div>\n\n<div class=\"hero\">\n  <div class=\"hero-tag\">📊 Executive Report</div>\n  <h1 class=\"hero-title\">{{ report_title }}</h1>\n  <p class=\"hero-subtitle\">Strategic overview and performance summary for the reporting period.</p>\n  <div class=\"hero-divider\">\n    <span>{{ report_date }}</span>\n    Prepared by {{ author }}\n  </div>\n</div>\n\n<div class=\"main\">\n\n  <!-- KPI Cards -->\n  <div class=\"kpi-grid\">\n    <div class=\"kpi-card\">\n      <div class=\"kpi-label\">{{ kpi1_label }}</div>\n      <div class=\"kpi-value\">{{ kpi1_value }}</div>\n    </div>\n    <div class=\"kpi-card\">\n      <div class=\"kpi-label\">{{ kpi2_label }}</div>\n      <div class=\"kpi-value\">{{ kpi2_value }}</div>\n    </div>\n    <div class=\"kpi-card\">\n      <div class=\"kpi-label\">{{ kpi3_label }}</div>\n      <div class=\"kpi-value\">{{ kpi3_value }}</div>\n    </div>\n    <div class=\"kpi-card\">\n      <div class=\"kpi-label\">{{ kpi4_label }}</div>\n      <div class=\"kpi-value\">{{ kpi4_value }}</div>\n    </div>\n  </div>\n\n  <!-- Executive Summary -->\n  <div class=\"summary-box\">\n    <div class=\"summary-label\">Executive Summary</div>\n    <div class=\"summary-text\">{{ executive_summary }}</div>\n  </div>\n\n  <!-- Section 1 -->\n  <div class=\"section\">\n    <div class=\"section-header\">\n      <div class=\"section-num\">01</div>\n      <div class=\"section-title\">{{ section1_title }}</div>\n    </div>\n    <div class=\"section-content\">{{ section1_content }}</div>\n  </div>\n\n  <!-- Section 2 -->\n  <div class=\"section\">\n    <div class=\"section-header\">\n      <div class=\"section-num\">02</div>\n      <div class=\"section-title\">{{ section2_title }}</div>\n    </div>\n    <div class=\"section-content\">{{ section2_content }}</div>\n  </div>\n\n</div>\n\n<div class=\"doc-footer\">\n  <span>{{ company }} &nbsp;·&nbsp; {{ report_title }}</span>\n  <span>{{ footer_text }}</span>\n</div>\n\n</body>\n</html>",
  "body_text": "",
  "header": "",
  "footer": "",
  "tags": ["report", "executive", "business", "kpi", "dark", "professional", "document"],
  "is_default": true,
  "variables": ["company","report_title","report_date","author","executive_summary","kpi1_label","kpi1_value","kpi2_label","kpi2_value","kpi3_label","kpi3_value","kpi4_label","kpi4_value","section1_title","section1_content","section2_title","section2_content","footer_text"],
  "created_at": "2026-09-19T08:00:00.000000+00:00",
  "updated_at": "2026-09-19T08:00:00.000000+00:00",
