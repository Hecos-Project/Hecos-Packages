{
    "tag": "NETSEARCH",
    "display_name": "Net Search",
    "name": "Net Search",
    "description": "Hecos Net Search & Intelligence System App. Privacy-preserving ClearWeb multi-engine meta-search, Tor DarkWeb (.onion) hidden services, OSINT identity lookup, media discovery, and deep file hunting.",
    "version": "1.3.4",
    "author": "Antonio Meloni",
    "lazy_load": false,
    "is_class_based": true,
    "type": "system_app",
    "status": "ONLINE",
    "icon": "fa-satellite-dish",
    "icon_url": "https://raw.githubusercontent.com/Hecos-Project/Hecos-Packages/main/Hecos_module_Image_preview_square.png",
    "screenshots": [
        "https://raw.githubusercontent.com/Hecos-Project/Hecos-Packages/main/Hecos_module_Image_preview.png"
    ],
    "config_panel": {
        "tab_id": "netsearch",
        "tab_label": "Net Search & Tor",
        "tab_icon": "fa-satellite-dish",
        "template_file": "web/templates/config_netsearch.html",
        "js_file": "web/static/js/netsearch_panel.js",
        "js_files": [
            "web/static/js/search/hub/endpoints_adapters.js",
            "web/static/js/search/search_endpoints.js",
            "web/static/js/search/hub/sources_sqlite_ui.js",
            "web/static/js/search/hub/sources_importer.js",
            "web/static/js/search/search_sources.js",
            "web/static/js/search/hub/panel_network_controls.js",
            "web/static/js/search/hub/panel_node_actions.js",
            "web/static/js/netsearch_panel.js"
        ],
        "css_file": "web/static/css/search.css",
        "category": "SISTEMA",
        "api_routes_file": "web/routes.py",
        "config_api_get": "/hecos/api/plugins/net_search/config",
        "config_api_post": "/hecos/api/plugins/net_search/config"
    },
    "commands": {},
    "tool_schema": [
        {
            "function": {
                "name": "NETSEARCH__web_search",
                "description": "Searches the Clear Web using multi-engine aggregation (SearXNG, DuckDuckGo, Brave, Mojeek, Qwant). Returns dense summarized results with title, link, and snippet.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "query"
                    ],
                    "properties": {
                        "max_results": {
                            "default": 10,
                            "description": "Maximum number of search results to return (5 to 30).",
                            "type": "integer"
                        },
                        "query": {
                            "description": "The search query string.",
                            "type": "string"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__dark_search",
                "description": "Searches the Dark Web (.onion hidden services) through Ahmia, TorDex, Phobos, and onion crawlers routed through the local SOCKS5h Tor proxy.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "query"
                    ],
                    "properties": {
                        "max_results": {
                            "default": 10,
                            "description": "Maximum number of dark web results to return (5 to 25).",
                            "type": "integer"
                        },
                        "query": {
                            "description": "The search query string.",
                            "type": "string"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__deep_search",
                "description": "Aggregates Clear Web, Tor Dark Web, and file dorks simultaneously. Returns comprehensive multi-network intelligence.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "query"
                    ],
                    "properties": {
                        "max_results": {
                            "default": 15,
                            "description": "Maximum total combined results (10 to 40).",
                            "type": "integer"
                        },
                        "query": {
                            "description": "The search query string.",
                            "type": "string"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__media_search",
                "description": "Searches for images, videos, audio/soundtracks, and podcasts matching the query.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "query"
                    ],
                    "properties": {
                        "max_results": {
                            "default": 10,
                            "description": "Maximum media items to return.",
                            "type": "integer"
                        },
                        "media_type": {
                            "default": "all",
                            "description": "Filter by media type: 'all', 'images', 'videos', or 'audio'.",
                            "type": "string"
                        },
                        "query": {
                            "description": "The media search query.",
                            "type": "string"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__fetch_page",
                "description": "Reads, extracts and cleans the textual content of any webpage (Clearnet or Tor .onion) using fast HTTP and readability extraction.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "url"
                    ],
                    "properties": {
                        "max_chars": {
                            "default": 4000,
                            "description": "Maximum characters of cleaned text to return.",
                            "type": "integer"
                        },
                        "url": {
                            "description": "The target webpage URL (http:// or https://, including .onion addresses).",
                            "type": "string"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__file_search",
                "description": "Hunts for downloadable files and documents (PDF, DOCX, XLSX, ZIP, EPUB, etc.) using multi-extension file dork queries across the Clear Web and Archive.org open library.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "query"
                    ],
                    "properties": {
                        "query": {
                            "description": "The file search query string.",
                            "type": "string"
                        },
                        "file_types": {
                            "default": "pdf,docx,xlsx,zip,epub",
                            "description": "Comma-separated list of file extensions to hunt (e.g. 'pdf,docx,xlsx').",
                            "type": "string"
                        },
                        "max_results": {
                            "default": 20,
                            "description": "Maximum number of file results to return.",
                            "type": "integer"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__osint_search",
                "description": "OSINT identity hunt: concurrently probes 15+ major platforms (GitHub, Reddit, Telegram, Steam, Twitch, Medium, SoundCloud, Flickr, etc.) to discover active user profiles matching the given username.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "username"
                    ],
                    "properties": {
                        "username": {
                            "description": "The username or handle to investigate (single word, no spaces).",
                            "type": "string"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__stream_search",
                "description": "Searches live TV channels, radio stations, public webcams, or raw streams into a numbered channel lineup (CH 01..NN). Leave query empty (or 'all') to retrieve the complete list of all available channels.",
                "parameters": {
                    "type": "object",
                    "required": [],
                    "properties": {
                        "query": {
                            "default": "",
                            "description": "Channel or station search query (e.g. 'Rai 1', 'BBC', 'jazz'), or '' to list all available channels.",
                            "type": "string"
                        },
                        "category": {
                            "default": "all",
                            "description": "Stream category: 'all', 'tv', 'radio', 'webcam', or 'raw'.",
                            "type": "string"
                        },
                        "max_results": {
                            "default": 500,
                            "description": "Maximum number of streams to return (use 500 or 0 for full list).",
                            "type": "integer"
                        }
                    }
                }
            }
        },
        {
            "function": {
                "name": "NETSEARCH__stream_control",
                "description": "Controls Live TV/Radio playback and the TV Remote: play a channel by name or number, list all channels (list), switch channels (ch_up, ch_down, last), stop, pause, toggle fullscreen (fullscreen), adjust volume (vol_up, vol_down, set_volume, mute), switch output target (app, vlc, libvlc), or open in VLC Desktop.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "description": "Remote action: 'play', 'list', 'ch_up', 'ch_down', 'last', 'stop', 'pause', 'vol_up', 'vol_down', 'set_volume', 'mute', 'fullscreen', 'target', 'toggle_proxy', 'open_vlc', or 'status'.",
                            "type": "string"
                        },
                        "query": {
                            "default": "",
                            "description": "Channel or station name to tune into when action='play' (e.g. 'Rai 1', 'Rai News 24', 'BBC News').",
                            "type": "string"
                        },
                        "channel": {
                            "description": "Channel number (1..N) or channel name to tune into.",
                            "type": "string"
                        },
                        "category": {
                            "default": "",
                            "description": "Optional category filter ('tv', 'radio', 'webcam', 'all').",
                            "type": "string"
                        },
                        "volume": {
                            "description": "Volume percentage (0-100) when action='set_volume'.",
                            "type": "integer"
                        },
                        "target": {
                            "default": "",
                            "description": "Playback target: 'app' (In-App Player), 'vlc' (VLC Desktop), or 'libvlc' (Headless LibVLC).",
                            "type": "string"
                        }
                    }
                }
            }
        }
    ],
    "slash_commands": [],
    "pip_requirements": [
        "requests>=2.31.0",
        "requests[socks]>=2.31.0",
        "beautifulsoup4>=4.12.0",
        "lxml>=5.2.0",
        "readability-lxml>=0.8.1",
        "trafilatura>=1.8.0",
        "ddgs>=0.7.0",
        "simplexng>=0.1.0",
        "yt-dlp>=2024.8.0",
        "pillow>=10.0.0",
        "imageio-ffmpeg>=0.4.9",
        "python-vlc>=3.0.0",
        "waitress>=3.0.0",
        "PyYAML>=6.0",
        "psutil>=5.9.0",
        "sherlock-project>=0.15.0"
    ]
}