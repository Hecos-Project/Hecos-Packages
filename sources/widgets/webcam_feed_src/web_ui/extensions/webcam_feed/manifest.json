{
    "extension_id": "webcam_feed",
    "parent_plugin": "WEB_UI",
    "display_name": "Webcam Feed",
    "version": "1.0.0",
    "description": "Displays a live webcam feed inside the Hecos Hub sidebar using WebRTC.",
    "sidebar_widget": true,
    "eager_load": false,
    "visible": true,
    "room_visible": true,
    "room_span": 1,
    "room_height": 300,
    "config_schema": {
        "webcam_feed_enabled": {
            "type": "bool",
            "default": true,
            "description": "Enable Webcam Feed widget"
        }
    }
}
